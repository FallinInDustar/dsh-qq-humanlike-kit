# 影子模式计算器的环境变量（ops/mood/mood_shadow.py 读取）
MOOD_BOT_QQ=        # 你的 bot QQ 号
MOOD_OWNER_QQ=      # 主人 QQ 号
MOOD_OTHER_BOTS=    # 群里别家 bot 的 QQ，逗号分隔；没有就留空
MOOD_CHAT_DIR=/root/.dsh/dsh-onebot-qq/logs/qq_chat   # dsh-onebot-qq 的聊天留档目录
MOOD_SNOW_LOG=/root/snowluma.log                     # SnowLuma 日志（取 @/引用 证据）
MOOD_OPS_DIR=/root/.dsh/ops                          # 缓存与输出目录
